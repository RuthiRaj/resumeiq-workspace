# ResumeIQ backend — example environment. Copy to `.env` and fill in.
# NEVER commit a real `.env` (root .gitignore excludes `.env*`). No real values here.
#
# How to get the Supabase values: Supabase dashboard → project → Project Settings → API.
# SUPABASE_URL is your project URL, e.g. https://xyzcompany.supabase.co (placeholder shape only).

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS: comma-separated exact origins. No wildcard. Must include the frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Supabase Auth (JWT verification)
SUPABASE_URL=
# Optional override. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# Legacy HS256 shared-secret fallback (leave empty once asymmetric signing keys are in use).
SUPABASE_JWT_SECRET=
# Expected `aud` claim. Supabase Auth issues `authenticated` by default.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional expected `iss` claim. Defaults to ${SUPABASE_URL}/auth/v1.
SUPABASE_JWT_ISSUER=

# Request limits
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60
