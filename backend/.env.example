# ResumeIQ backend — example runtime environment. Copy to `.env` and fill in.
# NEVER commit a real `.env` (the root .gitignore excludes `.env*`).
# Integration-test credentials are NOT part of the runtime environment: they live
# in `.env.test` (see `.env.test.example`), which the app never loads.
#
# Where the Supabase values come from: Supabase dashboard → project → Project
# Settings → API. This file contains no real values, only placeholder shapes.

# --- App ---
# Environment name, reported by GET /health (e.g. development, test, production).
ENVIRONMENT=development
# Verbosity of the JSON stdout logger (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
# Base path every v1 route is mounted under.
API_V1_PREFIX=/api/v1
# Version reported by the API and used in the OpenAPI document.
APP_VERSION=0.1.0

# --- CORS ---
# Comma-separated exact origins allowed to call the API. No wildcard; include
# every frontend origin (local and deployed).
CORS_ORIGINS=http://localhost:3000

# --- Supabase ---
# Project URL, e.g. https://<project>.supabase.co (placeholder shape only).
# Required: derives the JWKS URL and the Data API base URL.
SUPABASE_URL=
# Optional JWKS endpoint used to verify asymmetric signing keys. Defaults to
# ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# Legacy HS256 shared-secret fallback. Leave empty once the project uses
# asymmetric signing keys, which are preferred (see ADR-010).
SUPABASE_JWT_SECRET=
# Expected `aud` claim; Supabase Auth issues `authenticated` by default.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional expected `iss` claim; defaults to ${SUPABASE_URL}/auth/v1.
SUPABASE_JWT_ISSUER=
# Data API `apikey` header (publishable/anon key). Required. User rows are read
# with the caller's JWT, so RLS applies. NEVER use the service_role key here or
# anywhere in this app (ADR-016).
SUPABASE_PUBLISHABLE_KEY=

# --- AI providers (B3; all OPTIONAL) ---
# The backend starts without these. An AI call then fails with the typed
# `ai_not_configured` error and nothing reaches the network. Keys are
# server-side only, never NEXT_PUBLIC_*. See docs/DECISIONS.md ADR-029 for the
# verified free-tier limits, data terms and model IDs.
#
# Groq is the primary provider. Defaults if left empty:
#   GROQ_BASE_URL=https://api.groq.com/openai/v1
#   GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_BASE_URL=
GROQ_MODEL=
#
# NVIDIA-hosted is the secondary provider. Defaults if left empty:
#   NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
#   NVIDIA_MODEL=openai/gpt-oss-20b
# (The old default meta/llama-3.3-70b-instruct is end-of-life: HTTP 410.)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
NVIDIA_MODEL=
#
# Gateway policy (non-secret). Provider names choose the fallback order.
AI_PRIMARY_PROVIDER=groq
AI_SECONDARY_PROVIDER=nvidia
AI_TIMEOUT_SECONDS=20.0
AI_MAX_RETRIES=1
AI_BACKOFF_BASE_SECONDS=0.5
AI_RETRY_AFTER_CAP_SECONDS=5.0
AI_MAX_OUTPUT_TOKENS=2048
AI_DAILY_QUOTA=50
AI_CACHE_TTL_SECONDS=900
AI_CACHE_MAX_ENTRIES=256

# --- Limits ---
# Maximum accepted request body in bytes; larger bodies get HTTP 413.
MAX_REQUEST_BYTES=1048576
# Per-IP requests allowed per minute (in-memory, single-process limiter; ADR-009).
RATE_LIMIT_PER_MINUTE=60
# Document import (B2). MAX_IMPORT_BYTES caps an import upload (the import route
# gets this limit instead of MAX_REQUEST_BYTES); EXTRACTION_TIMEOUT_SECONDS
# bounds a single PDF/DOCX parse.
MAX_IMPORT_BYTES=5242880
EXTRACTION_TIMEOUT_SECONDS=8.0
