# ResumeIQ backend — example environment. Copy to `.env` and fill in.
# NEVER commit a real `.env` (root .gitignore excludes `.env*`). No real values here.
#
# How to get the Supabase values: Supabase dashboard → project → Project Settings → API.
# SUPABASE_URL is your project URL, e.g. https://xyzcompany.supabase.co (placeholder shape only).

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# CORS: comma-separated exact origins. No wildcard. Must include the frontend origin(s).
CORS_ORIGINS=http://localhost:3000

# Supabase Auth (JWT verification)
SUPABASE_URL=
# Optional override. Defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=
# Legacy HS256 shared-secret fallback (leave empty once asymmetric signing keys are in use).
SUPABASE_JWT_SECRET=
# Expected `aud` claim. Supabase Auth issues `authenticated` by default.
SUPABASE_JWT_AUDIENCE=authenticated
# Optional expected `iss` claim. Defaults to ${SUPABASE_URL}/auth/v1.
SUPABASE_JWT_ISSUER=

# Request limits
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_PER_MINUTE=60

# Supabase Data API (B1 workspace). Publishable/anon key is the `apikey` header;
# user rows are reached with the caller's JWT so RLS applies. NEVER use the
# service_role key here.
SUPABASE_PUBLISHABLE_KEY=

# Integration tests (opt-in). Set RUN_SUPABASE_INTEGRATION=1 plus SUPABASE_URL /
# SUPABASE_PUBLISHABLE_KEY above AND the two test users below. Create them in the
# Supabase dashboard (Authentication -> Users -> Add user, auto-confirm on); their
# credentials are exchanged for access tokens by tests/supabase_auth.py. Left
# unset, the integration tests are skipped (unit tests need no project).
# NEVER commit `.env`; these are real credentials.
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
# Optional: reuse an already-signed-in access token instead of the email/password
# pair (handy for a one-off run). Never commit a real token.
SUPABASE_TEST_TOKEN_A=
SUPABASE_TEST_TOKEN_B=
