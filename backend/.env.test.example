# ResumeIQ backend — example integration-test environment. Copy to `.env.test`
# (git-ignored) and fill in real values. NEVER commit `.env.test`.
#
# Read only by `tests/supabase_auth.py`. The runtime app reads `.env`
# (see `.env.example`) and never loads this file, so a deployed backend never
# holds test passwords. `SUPABASE_URL` and `SUPABASE_PUBLISHABLE_KEY` come from
# the runtime `.env`. Create the two test users in the Supabase dashboard
# (Authentication → Users → Add user, auto-confirm on).

# --- Integration tests ---
# Opt-in gate: 1 runs the integration tests, 0 or unset skips them.
RUN_SUPABASE_INTEGRATION=0
# User A: the caller that performs the mutations.
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
# User B: the "other user" used by the isolation tests (optional).
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
# Optional: reuse an already-signed-in access token instead of the email/password
# pair (handy for a one-off run). Never commit a real token.
SUPABASE_TEST_TOKEN_A=
SUPABASE_TEST_TOKEN_B=
