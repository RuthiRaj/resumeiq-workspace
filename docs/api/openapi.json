{
  "openapi": "3.1.0",
  "info": {
    "title": "ResumeIQ API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health check",
        "operationId": "get_health_health_get",
        "responses": {
          "200": {
            "description": "Service is up.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Current caller identity",
        "operationId": "get_me_api_v1_me_get",
        "responses": {
          "200": {
            "description": "Valid Supabase JWT.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "examples": [
              "ok"
            ]
          },
          "version": {
            "type": "string",
            "title": "Version",
            "examples": [
              "0.1.0"
            ]
          },
          "environment": {
            "type": "string",
            "title": "Environment",
            "examples": [
              "development"
            ]
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment"
        ],
        "title": "HealthResponse"
      },
      "MeResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "examples": [
              "123e4567-e89b-12d3-a456-426614174000"
            ]
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "examples": [
              "user@example.com"
            ]
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Role",
            "examples": [
              "authenticated"
            ]
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "MeResponse",
        "description": "Authenticated caller identity. PII-minimal: only what the token asserts."
      }
    }
  }
}
