# Editor defaults for the whole workspace.
# charset = utf-8 means UTF-8 without a BOM; do not use utf-8-bom for source files.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false

[*.{json,jsonc,yml,yaml,toml}]
indent_size = 2

[Makefile]
indent_style = tab
