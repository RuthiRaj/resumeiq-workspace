# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# builds
.next/
out/
build/
dist/

# testing
coverage/
test-results/
playwright-report/

