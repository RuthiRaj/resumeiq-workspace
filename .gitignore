# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# builds
.next/
out/
build/
dist/

# testing
coverage/
test-results/
playwright-report/

# env files (never commit secrets)
.env*
!.env.example
!.env.test.example

# typescript
*.tsbuildinfo
next-env.d.ts

# vercel
.vercel

# misc
.DS_Store
Thumbs.db
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# documents: never commit user uploads or private fixtures. Golden test
# fixtures under a tests/golden/ directory are the only exception.
*.pdf
*.docx
!**/tests/golden/**
private-fixtures/

# scratch/temp files written by ad-hoc runs and e2e debugging
.tmp-*

# lighthouse lab artifacts
lh-*.json

# next dev writes AGENTS.md into its project dir (frontend/) whenever it detects
# an AI agent; the canonical copy is the root AGENTS.md (see ADR-007), so never
# commit the generated duplicate.
frontend/AGENTS.md
